CPANEL_ADDR=127.0.0.1:8256
CPANEL_DATABASE_URL=postgres://cpanel:cpanel@127.0.0.1:5432/cpanel?sslmode=disable
CPANEL_EXTERNAL_URL=http://127.0.0.1:8256
CPANEL_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
CPANEL_COOKIE_SECURE=false
CPANEL_SESSION_TTL=24h
CPANEL_AGENT_HEARTBEAT_INTERVAL=60s
CPANEL_AGENT_TELEMETRY_INTERVAL=60s
CPANEL_AGENT_FALLBACK_PULL_INTERVAL=60s
CPANEL_AGENT_ARTIFACT_DIR=/var/lib/cpanel/agent-artifacts
